# =====================================================
# ENV EXAMPLE - Sao chép thành .env.local khi dev local
# Điền giá trị thật vào Netlify Environment Variables khi deploy
# =====================================================

# Gemini AI API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# App URL (tự động inject bởi Netlify/Cloud Run)
APP_URL="your-app-url-here"

# =====================================================
# Firebase Configuration
# Lấy từ Firebase Console > Project Settings > General
# =====================================================
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"
